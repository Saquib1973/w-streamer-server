# ─────────────────────────────────────────────────────────────
# Database — Supabase used ONLY as hosted Postgres (via Prisma)
# Special characters in the password MUST be URL-encoded (@ → %40, # → %23, / → %2F, : → %3A)
# ─────────────────────────────────────────────────────────────

# Direct connection — used by `prisma migrate` / `prisma db push`.
# NOTE: db.<ref>.supabase.co is IPv6-only unless the Supabase IPv4 add-on is enabled.
# If your network has no IPv6, use the Session pooler (port 5432) URL here instead.
DIRECT_URL="postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# Runtime connection — prefer Supavisor (Dashboard → Connect).
#   Session mode  (long-running Node server, recommended):
#     postgresql://postgres.<PROJECT_REF>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Transaction mode (serverless; requires pgbouncer flag):
#     postgresql://postgres.<PROJECT_REF>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres"

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=8787
PUBLIC_BASE_URL="http://192.168.1.10:8787"   # LAN/public URL the app & players use for stream links
CORS_ORIGINS="*"

# ─────────────────────────────────────────────────────────────
# Auth (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="<random-64+-chars>"
JWT_REFRESH_SECRET="<random-64+-chars>"
STREAM_TOKEN_SECRET="<random-64+-chars>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
STREAM_TOKEN_TTL="6h"

# One-time secret required to create the first ADMIN. After the admin exists, registration is locked permanently.
ADMIN_SETUP_TOKEN="<random-32+-chars>"

# ─────────────────────────────────────────────────────────────
# Token Vault — AES-256-GCM master key (exactly 32 bytes, base64)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: add a new key as VAULT_KEY_V2 and set VAULT_ACTIVE_KEY_VERSION=2; old rows decrypt with their stored keyVersion.
# ─────────────────────────────────────────────────────────────
VAULT_KEY_V1="<base64-32-bytes>"
VAULT_ACTIVE_KEY_VERSION=1

# ─────────────────────────────────────────────────────────────
# Torrent engine
# ─────────────────────────────────────────────────────────────
TORRENT_CACHE_DIR="./.torrent-cache"
TORRENT_MAX_CONNS=80
TORRENT_IDLE_TIMEOUT_MIN=20
TORRENT_MAX_ACTIVE=4
